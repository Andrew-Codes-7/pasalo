# Copy this file to `.env.local` and paste your own values in.
#
#   cp .env.local.example .env.local
#   open -e .env.local
#
# `.env.local` is already in .gitignore, so it never reaches GitHub.

# ---------------------------------------------------------------------------
# Project URL
#
# Supabase dashboard → Project Settings → Data API → "Project URL".
#
# If you cannot find it, read it off the browser address bar. The dashboard URL
# looks like  https://supabase.com/dashboard/project/abcdefghijklmnop
# so your Project URL is  https://abcdefghijklmnop.supabase.co
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# ---------------------------------------------------------------------------
# Publishable key  (older dashboards call this the "anon" or "public" key)
#
# Supabase dashboard → Project Settings → API Keys → "Publishable key".
# It may start with `sb_publishable_` or with `eyJ` — either is correct.
#
# This key is MEANT to be public. It ships in every visitor's browser and
# grants nothing by itself, because Row Level Security decides what any
# request can actually read or write.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-the-publishable-key-here

# ---------------------------------------------------------------------------
# DO NOT put the "Secret key" (older name: service_role) in this file, in the
# app, or in a chat. It bypasses every security rule in the database. Nothing
# in Pasalo needs it. If some future feature does, it goes in Netlify's
# environment variables and nowhere else.
# ---------------------------------------------------------------------------
